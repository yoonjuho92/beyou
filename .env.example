# ── Supabase ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# publishable key(sb_publishable_...) 권장. 기존 anon key를 쓰려면 NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 서버 전용. 인제스트/관리 작업에만 사용, 클라이언트 노출 금지
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── OpenAI ───────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna
# 보조 작업(유저 지식 요약, 대화 유도 문구)용 모델. 비우면 OPENAI_MODEL 사용
# OPENAI_UTILITY_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 마이그레이션의 vector(N)과 반드시 일치
EMBEDDING_DIMENSIONS=1536
# OPENAI_ORG_ID=org-...
# OPENAI_PROJECT_ID=proj_...

# ── Chat ─────────────────────────────────────────
CHAT_HISTORY_LIMIT=20
CHAT_MAX_INPUT_CHARS=2000
CHAT_RATE_LIMIT_PER_MIN=20
NEXT_PUBLIC_DEFAULT_CHARACTER=beyou

# ── RAG (과거 대화 기억 검색) ─────────────────────
RAG_MEMORY_TOP_K=5
RAG_MEMORY_THRESHOLD=0.35
RAG_MAX_CONTEXT_TOKENS=1500

# ── 선택: Upstash 레이트리밋 ──────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
